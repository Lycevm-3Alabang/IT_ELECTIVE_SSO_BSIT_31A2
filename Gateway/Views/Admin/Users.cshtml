@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "User Management";
}

<style>
    body {
        background-color: #f0f4f9;
    }

    .dark-card {
        background-color: #101625;
        border-radius: 10px;
        border: none;
        color: #ffffff;
    }

    .dark-header {
        background-color: #101625;
        border-radius: 10px;
        color: #ffffff;
        padding: 16px 24px;
    }
    .custom-dark-table {
        width: 100%;
        color: #ffffff;
        background-color: transparent !important;
        border-collapse: collapse;
    }

        .custom-dark-table th {
            color: #8a99ad;
            font-size: 0.8rem;
            font-weight: 700;
            letter-spacing: 0.5px;
            border-bottom: 1px solid #232d3f;
            padding: 16px 12px;
            background-color: transparent !important;
        }

        .custom-dark-table td {
            border-bottom: 1px solid #1a2232;
            padding: 16px 12px;
            vertical-align: middle;
            color: #d1d5db;
            background-color: transparent !important;
        }

        .custom-dark-table tr {
            background-color: transparent !important;
        }

    .btn-azure {
        background-color: #0088cc;
        color: #ffffff;
        border: none;
        font-weight: 600;
    }

        .btn-azure:hover {
            background-color: #0077b5;
            color: #ffffff;
        }

    .btn-view-blue {
        background-color: #0088cc;
        color: #ffffff;
        border: none;
        padding: 6px 16px;
        border-radius: 5px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .btn-delete-red {
        background-color: #e55353;
        color: #ffffff;
        border: none;
        padding: 6px 16px;
        border-radius: 5px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .badge-active-green {
        background-color: #00c853;
        color: #ffffff;
        font-weight: 600;
        padding: 6px 14px;
        border-radius: 6px;
    }

    .badge-suspended-gray {
        background-color: #6c757d;
        color: #ffffff;
        font-weight: 600;
        padding: 6px 14px;
        border-radius: 6px;
    }

    .search-input-dark {
        border-radius: 6px;
        border: none;
        padding-left: 38px;
        background-color: #ffffff;
        color: #000000;
    }

    .search-icon-inside {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        z-index: 10;
        color: #6c757d;
    }
</style>

<div class="container-fluid px-4 py-3">
    <div class="dark-header mb-3 shadow-sm">
        <h3 class="fw-bold mb-0">User Management</h3>
    </div>

    <div class="dark-card p-4 shadow">
        <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-secondary border-opacity-25">
            <div class="position-relative" style="width: 320px;">
                <i class="bi bi-search search-icon-inside"></i>
                <input type="text" id="emailSearchInput" class="form-control search-input-dark" placeholder="Search by Email" onkeyup="filterUsersByEmail()" data-testid="search-email-input">
            </div>
            <button type="button" class="btn btn-azure px-3 py-2 rounded-2" data-bs-toggle="modal" data-bs-target="#createUserModal" data-testid="add-user-btn">
                + Add New User
            </button>
        </div>

        <div class="table-responsive">
            <table class="custom-dark-table align-middle" id="usersTable" data-testid="users-table">
                <thead>
                    <tr>
                        <th class="ps-2">EMAIL</th>
                        <th>CREATED DATE</th>
                        <th>STATUS</th>
                        <th class="text-center">ACTIVE TOGGLE</th>
                        <th class="text-end pe-2">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    <tr data-user-id="1">
                        <td class="ps-2 fw-medium text-white user-email">example@gmail.com</td>
                        <td>2026-08-26</td>
                        <td><span class="badge badge-active-green status-badge">Active</span></td>
                        <td class="text-center">
                            <span class="me-2 fw-bold small text-light toggle-label">ON</span>
                            <div class="form-check form-switch d-inline-block align-middle mb-0">
                                <input class="form-check-input user-toggle-switch" type="checkbox" checked id="toggle_1" onchange="toggleUserStatus(1, this)" data-testid="toggle-user-1">
                            </div>
                        </td>
                        <td class="text-end pe-2">
                            <button class="btn btn-view-blue me-2" data-bs-toggle="modal" data-bs-target="#userDetailsModal" onclick="loadUserDetails('example@gmail.com', 'Active', 'Sales App Admin, Support Team', '2026-09-02 17:23')" data-testid="view-user-1">
                                View
                            </button>
                            <button class="btn btn-delete-red" data-bs-toggle="modal" data-bs-target="#deleteUserModal" onclick="setDeleteUserTarget(1, 'example@gmail.com')" data-testid="delete-user-1">
                                Delete
                            </button>
                        </td>
                    </tr>

                    <tr data-user-id="2">
                        <td class="ps-2 fw-medium text-white user-email">example123@gmail.com</td>
                        <td>2026-08-25</td>
                        <td><span class="badge badge-suspended-gray status-badge">Suspended</span></td>
                        <td class="text-center">
                            <span class="me-2 fw-bold small text-secondary toggle-label">OFF</span>
                            <div class="form-check form-switch d-inline-block align-middle mb-0">
                                <input class="form-check-input user-toggle-switch" type="checkbox" id="toggle_2" onchange="toggleUserStatus(2, this)" data-testid="toggle-user-2">
                            </div>
                        </td>
                        <td class="text-end pe-2">
                            <button class="btn btn-view-blue me-2" data-bs-toggle="modal" data-bs-target="#userDetailsModal" onclick="loadUserDetails('example123@gmail.com', 'Suspended', 'None', '2026-08-25 10:15')" data-testid="view-user-2">
                                View
                            </button>
                            <button class="btn btn-delete-red" data-bs-toggle="modal" data-bs-target="#deleteUserModal" onclick="setDeleteUserTarget(2, 'example123@gmail.com')" data-testid="delete-user-2">
                                Delete
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@await Html.PartialAsync("_CreateUserModal")
@await Html.PartialAsync("_UserDetailsModal")
@await Html.PartialAsync("_DeleteUserModal")

@section Scripts {
    <script src="~/js/admin-users.js" asp-append-version="true"></script>
}