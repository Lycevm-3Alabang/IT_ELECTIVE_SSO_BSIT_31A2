@using ITElectiveSSO.Models
@{
    bool hasData = ViewBag.HasData ?? false;
    var logs = ViewBag.RecentLogs as List<AuditLog> ?? new List<AuditLog>();
}

<div class="card border-0 shadow-sm" style="min-height: 350px;">
    <div class="card-body p-0 d-flex flex-column">
        <div class="table-responsive flex-grow-1">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3 py-3">USERID</th>
                        <th class="py-3">EMAIL</th>
                        <th class="py-3">ACTION</th>
                        <th class="py-3">TIMESTAMP</th>
                        <th class="py-3">STATUS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!hasData)
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted align-middle">
                                <div class="py-4">
                                    <i class="bi bi-inbox fs-1 d-block mb-3 opacity-50"></i>
                                    <span class="fs-6 fw-normal">No audit logs available.</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var log in logs)
                        {
                            var failed = log.Action.EndsWith("Failed", StringComparison.OrdinalIgnoreCase);
                            var shortId = string.IsNullOrEmpty(log.UserId)
                                ? "-"
                                : (log.UserId.Length > 8 ? log.UserId[..8] + "…" : log.UserId);

                            <tr>
                                <td class="ps-3 font-monospace py-3" title="@log.UserId">@shortId</td>
                                <td class="py-3">@(log.User?.Email ?? "-")</td>
                                <td class="py-3">@log.Action</td>
                                <td class="py-3">@log.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="py-3">
                                    @if (failed)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger px-3 py-2">Failed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success px-3 py-2">Success</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
