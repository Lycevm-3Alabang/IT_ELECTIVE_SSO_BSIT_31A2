@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="mt-auto px-2 pt-3 border-top border-secondary border-opacity-25">
    <div class="d-flex align-items-center mb-3">
        <div class="bg-info rounded-circle text-center text-white me-3 d-flex align-items-center justify-content-center flex-shrink-0 fs-6 fw-bold" style="width: 38px; height: 38px;">
            @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
        </div>
        <div class="overflow-hidden">
            <strong class="d-block text-white fs-6 fw-bold text-truncate">@(User.Identity?.Name ?? "User")</strong>
            <small class="text-white-50 d-block text-truncate" style="font-size: 0.85rem;">@(User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "")</small>
        </div>
    </div>

    <!-- Trigger Button -->
    <button type="button" class="btn btn-outline-danger w-100 fs-6 py-2 fw-semibold" data-bs-toggle="modal" data-bs-target="#logoutModal">
        <i class="bi bi-box-arrow-right me-1"></i> Logout
    </button>
</div>
