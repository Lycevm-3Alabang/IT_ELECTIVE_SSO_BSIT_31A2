@model ITElectiveSSO.Models.LoginViewModel
@{
    // Scaffold Identity login page - VILLAMOR
    // code here
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <!-- Customize layout and branding - CABARDO -->
    <!-- code here -->
</head>
<body>
    <!-- Scaffold Identity login page - VILLAMOR -->
    <div class="sso-page">
        <div class="sso-bg" aria-hidden="true"></div>
        <main class="sso-wrapper">
            <header class="sso-header">
                <!-- Add SSO title "IT ELECTIVE - SSO" - CABARDO -->
                <h1 class="sso-title">IT ELECTIVE <span class="sso-title-dash">&ndash;</span> SSO</h1>
                <p class="sso-subtitle">SIGN IN&ndash;ON AUTH SERVICE</p>

            </header>

            <!-- Display app name if provided in returnUrl - LLORENTE -->
            <!-- code here -->

            <!-- Customize layout and branding - CABARDO -->
            <!-- code here -->
                <!-- Style error messages clearly - CABARDO -->
                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="sso-alert" role="alert" aria-live="assertive" id="login-error">
                        <svg class="sso-alert-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.72-1.36 3.486 0l6.516 11.59c.75 1.334-.213 2.985-1.743 2.985H3.484c-1.53 0-2.493-1.65-1.743-2.985L8.257 3.1zM11 13a1 1 0 10-2 0 1 1 0 002 0zm-.25-6.25a.75.75 0 00-1.5 0v3.5a.75.75 0 001.5 0v-3.5z" clip-rule="evenodd" />
                        </svg>
                        <span>@Model.ErrorMessage</span>
                    </div>
                }

                <!-- Ensure form is accessible (labels, aria attributes) - FACTOR -->
                <!-- code here -->
                        <!-- Style error messages clearly - CABARDO -->
                        <span asp-validation-for="Email" class="sso-field-error" id="email-error"></span>
                    </div>

                    <div class="sso-field">
                        <label asp-for="Password">Password</label>
                        <input asp-for="Password"
                               type="password"
                               autocomplete="current-password"
                               required
                               aria-required="true"
                               aria-invalid="@(ViewData.ModelState["Password"]?.Errors.Count > 0 ? "true" : "false")"
                               aria-describedby="password-error" />
                        <!-- Style error messages clearly - CABARDO -->
                        <span asp-validation-for="Password" class="sso-field-error" id="password-error"></span>
                    </div>

                    <div class="sso-remember">
                        <input asp-for="RememberMe" type="checkbox" id="RememberMe" />
                        <label for="RememberMe">Remember me</label>
                    </div>

                    <button type="submit" class="sso-submit">Sign In</button>
                </form>

                <!-- Remove/lock down registration links - DAYGON -->
            </div>

                <!-- code here -->
        </main>
    </div>
</body>
</html>
